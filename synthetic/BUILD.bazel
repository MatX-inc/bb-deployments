# Synthetic load for bare/token_scenario.sh.
#
# Every command embeds $(RUN_ID), which the script passes as
# --define=RUN_ID=<unique>, so no run is an action cache hit. Building without
# it fails on purpose.

TOKENED_COUNT = 10

CONTROL_COUNT = 4

[
    genrule(
        name = "tokened_%d" % i,
        outs = ["tokened_%d.txt" % i],
        cmd = "sleep 20 && echo tokened_%d run=$(RUN_ID) > $@" % i,
        exec_properties = {"token:synthetic": "1"},
    )
    for i in range(TOKENED_COUNT)
]

# Token-free work that must never wait behind a saturated pool.
[
    genrule(
        name = "control_%d" % i,
        outs = ["control_%d.txt" % i],
        cmd = "sleep 5 && echo control_%d run=$(RUN_ID) > $@" % i,
    )
    for i in range(CONTROL_COUNT)
]

# Requires a token pool the scheduler does not configure.
genrule(
    name = "bogus",
    outs = ["bogus.txt"],
    cmd = "sleep 1 && echo bogus run=$(RUN_ID) > $@",
    exec_properties = {"token:bogus": "1"},
)

# Requires more tokens than the pool's capacity of 2.
genrule(
    name = "oversized",
    outs = ["oversized.txt"],
    cmd = "sleep 1 && echo oversized run=$(RUN_ID) > $@",
    exec_properties = {"token:synthetic": "3"},
)

filegroup(
    name = "tokened",
    srcs = ["tokened_%d" % i for i in range(TOKENED_COUNT)],
)

filegroup(
    name = "controls",
    srcs = ["control_%d" % i for i in range(CONTROL_COUNT)],
)

# Scenario i (reservation window): worker X serves platform pool=x with
# concurrency 1; the default worker serves the empty platform. The pool has
# capacity 1 in that scenario.
genrule(
    name = "i_a",
    outs = ["i_a.txt"],
    cmd = "sleep 20 && echo i_a run=$(RUN_ID) > $@",
    exec_properties = {
        "pool": "x",
        "token:synthetic": "1",
    },
)

genrule(
    name = "i_b",
    outs = ["i_b.txt"],
    cmd = "sleep 20 && echo i_b run=$(RUN_ID) > $@",
    exec_properties = {
        "pool": "x",
        "token:synthetic": "1",
    },
)

# Token-free filler that keeps worker X busy after i_a, so that i_b's
# reservation is held for its whole duration.
genrule(
    name = "i_e",
    outs = ["i_e.txt"],
    cmd = "sleep 40 && echo i_e run=$(RUN_ID) > $@",
    exec_properties = {"pool": "x"},
)

# Tokened work for the default platform, whose worker is idle; it must still
# wait while the token is reserved for i_b.
genrule(
    name = "i_f",
    outs = ["i_f.txt"],
    cmd = "sleep 20 && echo i_f run=$(RUN_ID) > $@",
    exec_properties = {"token:synthetic": "1"},
)
